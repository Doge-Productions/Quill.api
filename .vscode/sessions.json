{
    "$schema": "https://cdn.statically.io/gh/nguyenngoclongdev/cdn/main/schema/v10/terminal-keeper.json",
    "theme": "tribe",
    "active": "default",
    "activateOnStartup": true,
    "keepExistingTerminals": false,
    "sessions": {
        "default": [
            {
                "name": "install npm",
                "autoExecuteCommands": true,
                "icon": "person",
                "color": "terminal.ansiGreen",
                "commands": [
                    "npm install"
                ]
            },
            [
                {
                    "name": "build:test",
                    "autoExecuteCommands": true,
                    "cwd": "javascript/",
                    "icon": "play",
                    "color": "terminal.ansiGreen",
                    "commands": [
                        "tsup --watch"
                    ]
                },
                {
                    "name": "build:relese",
                    "autoExecuteCommands": true,
                    "icon": "play",
                    "color": "terminal.ansiGreen",
                    "commands": [
                        "tsup"
                    ]
                }
                
            ]
        ],
        "saved-session": [
            {
                "name": "connect",
                "commands": [
                    ""
                ]
            }
        ]
    }
}